def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Update game strings JSON files to reflect GS_DEFINE() macros."
    )
    parser.add_argument(
        "-d",
        "--dry-run",
        action="store_true",
        help="Perform a dry run: show unified diffs instead of writing files.",
    )
    return parser.parse_args()


def collect(root_dir: Path) -> Iterable[Path]:
    return (
        path.relative_to(root_dir)
        for path in root_dir.rglob("*", recurse_symlinks=True)
        if path.is_file()
        and path.name not in IGNORED_FILES
    )


def tr1_og_files() -> Iterable[Path]:
    yield from (Path(line) for line in TR1_OG_FILES.splitlines() if line)


def tr1_ship_files() -> Iterable[Path]:
    yield from collect(DATA_DIR / "common/ship")
    yield from collect(PROJECT_PATHS[1].data_dir / "ship")
    yield from collect(DATA_REPO_ROOT_DIR / "tr1/ship")
    yield from collect(DATA_REPO_ROOT_DIR / "tr1ub/ship")


def tr1_files_win() -> Iterable[Path]:
    yield Path("TRX.exe")
    yield Path("cfg/TR1X.json5*")
