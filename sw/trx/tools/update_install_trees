def make_tree_string(paths: list[Path]) -> str:
    type Node = defaultdict[Any, Any]

    # build nested dict
    def tree() -> Node:
        return defaultdict(tree)

    root = tree()
    for path in paths:
        node = root
        for part in str(path).split("/"):
            node = node[part]

    def natural_sort_key(s: str) -> list[str | int]:
        return [
            int(text) if text.isdigit() else text.lower()
            for text in re.split("([0-9]+)", s)
        ]

    # recursive render
    def render(node: Node, prefix: str = "") -> list[str]:
        entries = sorted(node.keys(), key=natural_sort_key)
        lines = []
        for i, name in enumerate(entries):
            last = i == len(entries) - 1
            branch = "└── " if last else "├── "
            subprefix = "    " if last else "│   "
            lines.append(prefix + branch + name)
            if node[name]:
                lines.extend(render(node[name], prefix + subprefix))
        return lines

    return ".\n" + "\n".join(render(root))


def process_install_doc(content: str, platform: str, paths: list[Path]) -> str:
    result: list[str] = []
    found_marker = False
    lines = content.splitlines()
    while lines:
        line = lines.pop(0)
        if line == f'<details data-id="file-tree-{platform}">':
            result.append(line)
            while lines:
                line = lines.pop(0)
                if not line:
                    break
            result.append(
                "<pre><code>" + make_tree_string(paths) + "</code></pre>"
            )
            result.append("</details>")
            if lines:
                result.append(line)
        else:
            result.append(line)
    return "\n".join(result) + "\n"


def main() -> None:
    args = parse_args()
    vfs = VirtualFilesystem()

    trees: list[Path, str, Callable[[], Iterable[Path]]] = [
        (PROJECT_PATHS[1].docs_dir / "INSTALLING.md", "win", tr1_files_win),
        (PROJECT_PATHS[1].docs_dir / "INSTALLING.md", "mac", tr1_files_mac),
        (PROJECT_PATHS[2].docs_dir / "INSTALLING.md", "win", tr2_files_win),
        (PROJECT_PATHS[2].docs_dir / "INSTALLING.md", "mac", tr2_files_mac),
        (PROJECT_PATHS[3].docs_dir / "INSTALLING.md", "win", tr3_files_win),
        (PROJECT_PATHS[3].docs_dir / "INSTALLING.md", "mac", tr3_files_mac),
    ]

    for path, platform, func in trees:
        vfs.put(
            path, process_install_doc(vfs.get(path), platform, list(func()))
        )

    if args.dry_run:
        vfs.show_diff()
    else:
        vfs.commit()


if __name__ == "__main__":
    main()
