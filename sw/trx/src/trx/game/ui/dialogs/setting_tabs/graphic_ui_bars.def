X_UI_CFG_DYN_ENUM(ui.lara_sprint_bar.color,             .custom_handler = { .is_available = UI_Settings_SprintbarColor_IsAvailable,      .is_visible = UI_Settings_BarColorPC_IsVisible })
X_UI_CFG_DYN_ENUM(ui.lara_sprint_bar.color_ps1,         .custom_handler = { .is_available = UI_Settings_SprintbarColor_IsAvailable,      .is_visible = UI_Settings_BarColorPS1_IsVisible })
X_UI_CFG_DYN_ENUM(ui.lara_exposure_bar.color,           .custom_handler = { .is_available = UI_Settings_ExposurebarColor_IsAvailable,    .is_visible = UI_Settings_BarColorPC_IsVisible })
